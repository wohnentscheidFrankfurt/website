---
// Flyer of the next event on the start page, with a countdown above it.
// The clock is in the markup from the start, so the script does not shift the flyer. It fills it every 30 s.
// Without JavaScript (scripting: none) the date line shows instead of the clock.
// role="timer" is not live, so screen readers do not hear every update.
// On the flyer's corner a sticker: a save link to a JPEG of the flyer. The script makes it a share button where the browser
// can share files.
import { Picture, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDateBar, formatTimeLine } from "../lib/events";
import { flyerFor, localized, shareFileName } from "../lib/event-english";
import { route, type Lang } from "../i18n/routes";
import { ui } from "../i18n/ui";

interface Props {
  event: CollectionEntry<"events">;
  lang: Lang;
}
const { event, lang } = Astro.props;
const d = event.data;
const c = ui[lang].countdown;
const text = localized(d, lang);
const image = flyerFor(d, lang)!;
// "Sa. 28. November 2026 · 14:00 Uhr" or "Sat 28 November 2026 · 2 pm": the date and the start time only.
const dateLine = `${formatDateBar(d.start, lang)} · ${formatTimeLine({ start: d.start }, lang)}`;
// The image's alt is the whole flyer text. The link gets a short name, like the event cards.
const linkName = `${text.title} – ${formatDateBar(d.start, lang)}`;
// The shared file: the flyer re-encoded at its own size, without metadata. Under 600 KB for chats.
const jpeg = await getImage({ src: image.src, format: "jpeg", quality: 80 });
const fileName = shareFileName(event.id, lang, lang === "en" && d.en.flyer !== undefined);
---
<div class="countdown" role="timer" data-countdown data-start={d.start.toISOString()}
  data-end={d.end?.toISOString()}
  data-days-one={c.days[0]} data-days-many={c.days[1]}
  data-hours-one={c.hours[0]} data-hours-many={c.hours[1]}
  data-minutes-one={c.minutes[0]} data-minutes-many={c.minutes[1]}>
  <p class="date" data-date>{dateLine}</p>
  <p class="clock" data-clock>
    <span class="noch">{c.before}</span>
    <span class="unit"><span class="num" data-days></span> <span class="label" data-days-label></span></span>
    <span class="unit"><span class="num" data-hours></span> <span class="label" data-hours-label></span></span>
    <span class="unit"><span class="num" data-minutes></span> <span class="label" data-minutes-label></span></span>
  </p>
  <p class="running" data-running hidden>{c.running}</p>
</div>
<div class="flyer-box">
  <a class="flyer" data-flyer href={`${route(lang, "events")}#${event.id}`} aria-label={linkName}>
    <Picture src={image.src} formats={["avif", "webp"]} fallbackFormat="webp" widths={[440, 880, 1060]}
      sizes="(min-width: 472px) 440px, calc(100vw - 32px)" loading="eager" alt={image.alt} />
  </a>
  <!-- A sticker on the flyer's corner. It shows a short word; aria-label says what it does. -->
  <a class="share" data-share href={jpeg.src} download={fileName} aria-label={ui[lang].flyer.save}
    data-label-share={ui[lang].flyer.share} data-word-share={ui[lang].flyer.shareWord}>
    <span class="tilt">
      <svg class="plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.5 2.5 10.5 13.5" /><path d="M21.5 2.5 14.5 21.5l-4-8-8-4z" /></svg>
      <svg class="down" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7.5 10.5 12 15l4.5-4.5" /><path d="M4 17v3h16v-3" /></svg>
      <span data-word>{ui[lang].flyer.saveWord}</span>
    </span>
  </a>
</div>

<script>
  import { countdown, plural } from "../lib/events";

  const UNITS = ["days", "hours", "minutes"] as const;

  for (const box of document.querySelectorAll<HTMLElement>("[data-countdown]")) {
    const start = new Date(box.dataset.start!);
    const end = box.dataset.end ? new Date(box.dataset.end) : undefined;
    const part = (name: string) => box.querySelector<HTMLElement>(`[data-${name}]`)!;
    let timer: ReturnType<typeof setInterval> | undefined;
    const tick = () => {
      const left = countdown(start, end, new Date());
      part("clock").hidden = left.state !== "before";
      part("running").hidden = left.state !== "running";
      box.hidden = left.state === "over";
      if (left.state === "over") clearInterval(timer);
      if (left.state !== "before") return;
      for (const key of UNITS) {
        const one = box.dataset[`${key}One`]!;
        const many = box.dataset[`${key}Many`]!;
        const [num, label] = plural(left[key], one, many).split(" ");
        part(key).textContent = num;
        part(`${key}-label`).textContent = label;
      }
    };
    tick();
    timer = setInterval(tick, 30_000);
    // Background tabs throttle timers. Catch up when the tab shows again.
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") tick();
    });
  }

  // The save link becomes a share button where the browser can share this file: phones and Safari on the Mac.
  // The file is built before any click. Safari drops the click's gesture after an await, and share() then fails.
  // Until the file is ready, and wherever sharing fails, the link keeps its plain download.
  // A one-byte probe asks first, so browsers that cannot share files never load the JPEG.
  // The JPEG loads after the page, so it does not compete with the flyer image.
  const probe = new File([new Uint8Array(1)], "probe.jpg", { type: "image/jpeg" });
  if (navigator.canShare?.({ files: [probe] })) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-share]")) {
      const start = () => prepareShare(link).catch(() => {});
      if (document.readyState === "complete") start();
      else addEventListener("load", start, { once: true });
    }
  }

  async function prepareShare(link: HTMLAnchorElement) {
    const res = await fetch(link.href);
    if (!res.ok) return;
    const file = new File([await res.blob()], link.download, { type: "image/jpeg" });
    if (!navigator.canShare?.({ files: [file] })) return;
    let open = false; // a share sheet is open
    let fallback = false; // the next click is our own, for the download
    link.addEventListener("click", (event) => {
      if (fallback) {
        fallback = false;
        return;
      }
      event.preventDefault();
      if (open) return;
      open = true;
      // Only the file. People write their own words.
      navigator
        .share({ files: [file] })
        .catch((error: unknown) => {
          if (error instanceof DOMException && error.name === "AbortError") return; // the sheet was closed
          fallback = true;
          link.click();
        })
        .finally(() => {
          open = false;
        });
    });
    // Some Android apps never settle the promise. Back on the page, the button works again.
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") open = false;
    });
    link.setAttribute("aria-label", link.dataset.labelShare!);
    link.querySelector("[data-word]")!.textContent = link.dataset.wordShare!;
    link.dataset.ready = "";
  }
</script>

<style>
  .countdown {
    margin: 0 0 28px;
    text-align: center;
    font-family: var(--slab);
    color: var(--ink);
  }

  .countdown[hidden],
  .countdown [hidden] {
    display: none;
  }

  .countdown p {
    margin: 0;
  }

  /* With JavaScript the clock shows, without it the date line. */
  .date {
    display: none;
    font-stretch: var(--wide);
    font-weight: 700;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    line-height: 1.15;
  }

  .clock {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0 clamp(14px, 4vw, 36px);
  }

  .noch {
    font-stretch: var(--wide);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    line-height: 1;
  }

  .unit {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* The min-height keeps the empty spans one line high until the script fills them. */
  .num {
    min-height: 0.9em;
    font-stretch: var(--tight);
    font-weight: 900;
    font-size: clamp(3rem, 12vw, 5.5rem);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }

  .label {
    min-height: 1.2em;
    font-stretch: var(--wide);
    font-weight: 700;
    font-size: clamp(1rem, 3vw, 1.375rem);
    line-height: 1.2;
  }

  .running {
    font-stretch: var(--tight);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.25rem, 8vw, 3.5rem);
    line-height: 1;
  }

  @media (scripting: none) {
    .date {
      display: block;
    }

    .clock {
      display: none;
    }
  }

  /* Like the b-side "Mittagstisch": rounded corners, it grows a little with a soft shadow on hover.
     Red stays in the logo and the drawings, so the focus ring is ink. */
  .flyer {
    display: block;
    max-width: 440px;
    margin: 0 auto;
    border-radius: 8px;
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
  }

  .flyer :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .flyer:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .flyer:hover {
      transform: scale(1.05);
      box-shadow: 0 12px 32px rgb(0 0 0 / 0.25);
    }
  }

  .flyer-box {
    position: relative;
    max-width: 440px;
    margin: 0 auto;
  }

  /* The share sticker: turquoise, the opposite of the flyer's red, so it stands out from the flyer.
     Black text (9.5:1), a white ring and a black offset shadow like a misprint.
     Only the icon and the word tilt. A tilted box would grow sideways and make phones scroll.
     It hangs 8 px over the flyer's right edge: with its shadow and hover scale, that stays inside the 16 px gutter.
     z-index keeps it above the flyer when the flyer grows on hover. */
  .share {
    position: absolute;
    right: -8px;
    bottom: -26px;
    z-index: 1;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    border: 3px solid var(--paper);
    border-radius: 50%;
    background: #16cccc;
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    font-family: var(--slab);
    font-stretch: var(--tight);
    font-weight: 900;
    font-size: 1.35rem;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s ease-in-out;
  }

  .tilt {
    display: grid;
    justify-items: center;
    gap: 2px;
    transform: rotate(-12deg);
    transition: transform 0.2s ease-in-out;
  }

  .share svg {
    width: 34px;
    height: 34px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The paper plane once the script can share, the arrow down while it is a download. */
  .share .plane,
  .share[data-ready] .down {
    display: none;
  }

  .share[data-ready] .plane {
    display: block;
  }

  .share:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .share:hover {
      transform: scale(1.06);
    }

    .share:hover .tilt {
      transform: rotate(-4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flyer:hover,
    .share:hover {
      transform: none;
    }

    .share:hover .tilt {
      transform: rotate(-12deg);
    }
  }
</style>
