---
// Teaser of the map "Sozialraum Frankfurt" on the start page. The English start page shows it only while the
// English map is online (Home.astro). Each language links its own map and shows a screenshot of it.
// The images are screenshots of the map (teaser_image.mjs in the map repo). Their basemap needs the BKG credit.
// From 900 px image (2/3) and text (1/3) side by side, below stacked.
import { Picture } from "astro:assets";
import type { Lang } from "../i18n/routes";
import { ui } from "../i18n/ui";
import teaserDe from "../assets/map/teaser.png";
// The English image comes from the integration, so it is imported only while the English map is online.
import { englishTeaser } from "virtual:map";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].mapTeaser;
const MAPS = { de: "/sozialraum-frankfurt/", en: "/en/sozialraum-frankfurt/" };
const image = lang === "en" ? englishTeaser : teaserDe;
if (!image) throw new Error("The English map teaser needs the English map online (integrations/map.mjs).");
const map = MAPS[lang];
---
<section class="map-teaser" aria-labelledby="map-teaser-title">
  <h2 id="map-teaser-title">Sozialraum Frankfurt</h2>
  <figure>
    <a class="shot" href={map}>
      <Picture src={image} formats={["avif", "webp"]} fallbackFormat="webp" widths={[700, 1400, 2112]}
        sizes="(min-width: 1120px) 704px, (min-width: 900px) 64vw, 100vw"
        alt={t.imageAlt} />
    </a>
    <figcaption>{t.creditBefore}<a href="https://basemap.de">basemap.de</a>{t.creditAfter}</figcaption>
  </figure>
  <div class="text">
    <p>{t.text}</p>
    <a class="button" href={map}>{t.button}</a>
  </div>
</section>

<style>
  /* As big as "Mitmachen" above it. */
  h2 {
    margin: 0 0 20px;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
  }

  figure {
    margin: 0;
  }

  /* The map's own header is white, so a soft shadow sets it off the page, like the event cards. */
  .shot {
    display: block;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot:focus-visible,
  figcaption a:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  figcaption {
    margin-top: 8px;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  figcaption a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .text p {
    margin: 24px 0;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  @media (min-width: 900px) {
    .map-teaser {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 0 32px;
      align-items: end;
    }

    h2 {
      grid-column: 1 / -1;
    }

    /* The caption sits under the image, so lift the text to the image's bottom. */
    .text {
      padding-bottom: calc(8px + 1.4 * 0.875rem);
    }

    .text p {
      margin-top: 0;
    }
  }
</style>
