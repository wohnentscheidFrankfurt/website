---
// Teaser of the map "Sozialraum Frankfurt" on the German start page. The map is German only, so this has no
// English twin and its texts stay here, not in ui.ts.
// The image is a screenshot of the map (teaser_image.mjs in the map repo). Its basemap needs the BKG credit.
// From 900 px image (2/3) and text (1/3) side by side, below stacked.
import { Picture } from "astro:assets";
import teaser from "../assets/map/teaser.png";

const MAP = "/sozialraum-frankfurt/";
---
<section class="map-teaser" aria-labelledby="map-teaser-title">
  <h2 id="map-teaser-title">Sozialraum Frankfurt</h2>
  <figure>
    <a class="shot" href={MAP}>
      <Picture src={teaser} formats={["avif", "webp"]} fallbackFormat="webp" widths={[700, 1400, 2112]}
        sizes="(min-width: 1120px) 704px, (min-width: 900px) 64vw, 100vw"
        alt="Karte von Frankfurt: Anteil der Wohnungen von ABG und Nassauischer Heimstätte je Stadtteil, in Rottönen" />
    </a>
    <figcaption>Hintergrund: © <a href="https://basemap.de">basemap.de</a> / BKG, CC BY 4.0</figcaption>
  </figure>
  <div class="text">
    <p>Wir haben eine Karte gebaut, um die Gebiete Frankfurts für eine andere Wohn- und Klimapolitik aufzuschlüsseln. Schaut gerne rein, und gewinnt neue Perspektiven!</p>
    <a class="button" href={MAP}>Zur Karte</a>
  </div>
</section>

<style>
  /* As big as "Mitmachen" above it. */
  h2 {
    margin: 0 0 20px;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
  }

  figure {
    margin: 0;
  }

  /* The map's own header is white, so a soft shadow sets it off the page, like the event cards. */
  .shot {
    display: block;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot:focus-visible,
  figcaption a:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  figcaption {
    margin-top: 8px;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  figcaption a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .text p {
    margin: 24px 0;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  @media (min-width: 900px) {
    .map-teaser {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 0 32px;
      align-items: end;
    }

    h2 {
      grid-column: 1 / -1;
    }

    /* The caption sits under the image, so lift the text to the image's bottom. */
    .text {
      padding-bottom: calc(8px + 1.4 * 0.875rem);
    }

    .text p {
      margin-top: 0;
    }
  }
</style>
