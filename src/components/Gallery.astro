---
// Gallery of an event: a grid of pictures. A photo spans the full width, flip charts sit 2 per row, 4 from 720 px.
// Every picture links to its large image, a WebP at the width of the original. Astro never upscales.
// The link carries width and height of the large image (data-pswp-*), for the lightbox.
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../i18n/routes";

export interface GalleryItem {
  kind: "photo" | "flipchart";
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
interface Props {
  items: GalleryItem[];
  lang: Lang;
}
const { items } = Astro.props;
// Do not read item.src.src: it would copy the original JPEG with EXIF into dist.
const pictures = await Promise.all(items.map(async (item) => {
  const large = await getImage({ src: item.src, format: "webp", width: item.src.width });
  return { ...item, large: large.src, width: large.attributes.width, height: large.attributes.height };
}));
---
<ul class="gallery" data-gallery>
  {pictures.map((item) => (
    <li class={item.kind}>
      <figure>
        <a href={item.large} data-pswp-width={item.width} data-pswp-height={item.height} data-kind={item.kind}>
          {item.kind === "photo" ? (
            <Picture src={item.src} formats={["avif", "webp"]} widths={[480, 960]}
              sizes="(min-width: 720px) 90vw, 100vw" alt={item.alt} loading="lazy" />
          ) : (
            <Picture src={item.src} formats={["avif", "webp"]} widths={[240, 480]}
              sizes="(min-width: 720px) 20vw, 45vw" alt={item.alt} loading="lazy" />
          )}
        </a>
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    </li>
  ))}
</ul>
<style>
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 24px 0 0; padding: 0; list-style: none; }
  .gallery li.photo { grid-column: 1 / -1; }
  .gallery figure { margin: 0; }
  .gallery :global(img) { display: block; width: 100%; height: auto; }
  .photo :global(img) { filter: sepia(0.35); }
  .gallery a { display: block; }
  figcaption { margin-top: 4px; font-size: 0.9375rem; line-height: 1.3; }
  @media (min-width: 720px) {
    .gallery { grid-template-columns: repeat(4, 1fr); }
  }
</style>
