---
// Gallery of an event: a grid of pictures. A photo spans the full width, flip charts sit 2 per row, 4 from 720 px.
// Every picture links to its large image, a WebP at the width of the original. Astro never upscales.
// The link carries width and height of the large image (data-pswp-*), for the lightbox.
// The script turns the links into a PhotoSwipe lightbox. Without JavaScript a link opens the large image.
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../i18n/routes";
import { ui } from "../i18n/ui";

export interface GalleryItem {
  kind: "photo" | "flipchart";
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
interface Props {
  items: GalleryItem[];
  lang: Lang;
}
const { items, lang } = Astro.props;
const labels = ui[lang].gallery;
// Do not read item.src.src: it would copy the original JPEG with EXIF into dist.
const pictures = await Promise.all(items.map(async (item) => {
  const large = await getImage({ src: item.src, format: "webp", width: item.src.width });
  return { ...item, large: large.src, width: large.attributes.width, height: large.attributes.height };
}));
---
<ul class="gallery" data-gallery data-close={labels.close} data-zoom={labels.zoom} data-prev={labels.prev}
  data-next={labels.next} data-error={labels.error}>
  {pictures.map((item) => (
    <li class={item.kind}>
      <figure>
        <a href={item.large} data-pswp-width={item.width} data-pswp-height={item.height} data-kind={item.kind}>
          {item.kind === "photo" ? (
            <Picture src={item.src} formats={["avif", "webp"]} widths={[480, 960]}
              sizes="(min-width: 720px) 90vw, 100vw" alt={item.alt} loading="lazy" />
          ) : (
            <Picture src={item.src} formats={["avif", "webp"]} widths={[240, 480]}
              sizes="(min-width: 720px) 20vw, 45vw" alt={item.alt} loading="lazy" />
          )}
        </a>
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    </li>
  ))}
</ul>
<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const labels = gallery.dataset;
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: "a",
      // The core loads on the first click, not with the page.
      pswpModule: () => import("photoswipe"),
      bgOpacity: 1,
      closeTitle: labels.close,
      zoomTitle: labels.zoom,
      arrowPrevTitle: labels.prev,
      arrowNextTitle: labels.next,
      errorMsg: labels.error,
      // PhotoSwipe itself turns off its animations under prefers-reduced-motion.
    });
    // The caption of the picture in view, from its figcaption. Hidden when it has none.
    lightbox.on("uiRegister", () => {
      lightbox.pswp!.ui!.registerElement({
        name: "caption",
        appendTo: "root",
        onInit: (el, pswp) => {
          pswp.on("change", () => {
            const link = pswp.currSlide?.data.element;
            const text = link?.closest("figure")?.querySelector("figcaption")?.textContent ?? "";
            el.textContent = text;
            el.hidden = !text;
          });
        },
      });
    });
    // The photo stays sepia, as in the grid. Each slide has its own container.
    lightbox.on("slideInit", ({ slide }) => {
      slide.container.classList.toggle("sepia", slide.data.element?.dataset.kind === "photo");
    });
    // Back closes the lightbox: phones expect that. Opening adds one history entry.
    // A close by Esc, button or swipe takes the entry away again, so the next Back leaves the page.
    let entry = false;
    lightbox.on("beforeOpen", () => {
      history.pushState({ gallery: true }, "");
      entry = true;
    });
    addEventListener("popstate", () => {
      if (!entry) return;
      entry = false;
      lightbox.pswp?.close();
    });
    lightbox.on("close", () => {
      if (!entry) return;
      entry = false;
      history.back();
    });
    lightbox.init();
  }
</script>
<style>
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 24px 0 0; padding: 0; list-style: none; }
  .gallery li.photo { grid-column: 1 / -1; }
  .gallery figure { margin: 0; }
  .gallery :global(img) { display: block; width: 100%; height: auto; }
  .photo :global(img) { filter: sepia(0.35); }
  .gallery a { display: block; }
  figcaption { margin-top: 4px; font-size: 0.9375rem; line-height: 1.3; }
  @media (min-width: 720px) {
    .gallery { grid-template-columns: repeat(4, 1fr); }
  }
</style>
<style is:global>
  /* The lightbox is appended to <body>, outside this component. Our colors over PhotoSwipe's own CSS. */
  .pswp {
    --pswp-bg: var(--ink);
    --pswp-placeholder-bg: var(--ink);
    --pswp-icon-color: #fff;
    --pswp-icon-color-secondary: var(--ink);
    --pswp-icon-stroke-color: var(--ink);
    --pswp-error-text-color: #fff;
  }
  .pswp__button:hover .pswp__icn { fill: var(--hover); }
  .pswp__button:focus-visible { outline: 3px solid #fff; outline-offset: -6px; }
  .pswp__zoom-wrap.sepia img { filter: sepia(0.35); }
  .pswp__caption {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 12px var(--gutter) max(16px, env(safe-area-inset-bottom));
    color: #fff; font-family: var(--sans); font-size: 1rem; line-height: 1.3; text-align: center;
    background: rgb(17 17 17 / 0.75);
  }
  .pswp__caption[hidden] { display: none; }
</style>
