---
// Footer like b-side, but without its black link bar: the band "Bleib informiert" above already fills the space.
// Three centred columns. In the third column the icons stand in front of the names, like on b-side.
// The GitHub mark is from Simple Icons (CC0).
import { route, type Lang } from "../i18n/routes";
import { ui, ANCHORS } from "../i18n/ui";
import { INSTAGRAM, GITHUB } from "../lib/social";
import InstagramIcon from "./InstagramIcon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].frame;
---
<footer>
  <div class="footer-columns">
    <section>
      <h2>{t.footerColumn1}</h2>
      <a href={route(lang, "home")}>{t.footerHome}</a>
      <a href={route(lang, "events")}>{t.footerEvents}</a>
      <a href={route(lang, "imprint")}>{t.footerImprint}</a>
      <a href={route(lang, "privacy")}>{t.footerPrivacy}</a>
    </section>
    <section>
      <h2>{t.footerColumn2}</h2>
      <a href={`${route(lang, "home")}#${ANCHORS[lang].join}`}>{t.footerWriteUs}</a>
    </section>
    <section>
      <h2>{t.footerColumn3}</h2>
      <a class="platform" href={INSTAGRAM}>
        <InstagramIcon size={16} />
        <span>{t.footerInstagram}</span>
      </a>
      <a class="platform" href={GITHUB}>
        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        <span>GitHub</span>
      </a>
    </section>
  </div>
</footer>
<style>
  .footer-columns {
    display: grid;
    gap: 28px;
    padding: 32px var(--gutter) 40px;
    text-align: center;
    max-width: var(--width);
    margin: 0 auto;
  }
  @media (min-width: 720px) {
    .footer-columns { grid-template-columns: repeat(3, 1fr); }
  }
  .footer-columns section { display: flex; flex-direction: column; align-items: center; }
  /* Normal case and wider, like the menu. */
  .footer-columns h2 {
    font-stretch: var(--wide);
    font-weight: 700;
    text-transform: none;
    letter-spacing: normal;
    font-size: 1.125rem;
    margin: 0 0 4px;
  }
  .footer-columns a {
    font-size: 1rem;
    font-style: italic;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  /* Only the name is underlined, not the icon. */
  .footer-columns .platform { text-decoration: none; }
  .footer-columns .platform span { text-decoration: underline; text-underline-offset: 4px; }
  .platform :global(.icon) { flex: none; }
</style>
