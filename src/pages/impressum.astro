---
import Base from "../layouts/Base.astro";
import { ui } from "../i18n/ui";

const mail = "info@wohnentscheid-frankfurt.de";
---
<Base lang="de" title={ui.de.titles.imprint}>
  <div class="prose">
    <h1>Impressum</h1>
    <p>Diese Website gehört zur Initiative Wohnentscheid Frankfurt.</p>
    <h2>Angaben nach §&nbsp;5 DDG</h2>
    <address>
      Sven Nagel<br />
      Ostendstraße 9<br />
      60314&nbsp;Frankfurt am Main
    </address>
    <h2>Kontakt</h2>
    <p>E-Mail: <a href={`mailto:${mail}`}>{mail}</a></p>
    <h2>Verantwortlich für den Inhalt nach §&nbsp;18 Abs.&nbsp;2 MStV</h2>
    <p>Sven Nagel, Anschrift wie oben.</p>
    <h2>Bilder</h2>
    <p>Zeichnungen und Fotos: Wohnentscheid Frankfurt.</p>
  </div>
</Base>
